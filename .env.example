# ===========================================================================
# Variables d'environnement — Roue de la Fortune
# Copiez ce fichier en `.env.local` puis remplissez les valeurs.
# Sur Vercel : Project → Settings → Environment Variables.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. BASE DE DONNÉES (Neon — https://console.neon.tech)
#    Connection string "Pooled" recommandée (hostname en -pooler).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/roue?sslmode=require"

# ---------------------------------------------------------------------------
# 2. UPSTASH REDIS (https://console.upstash.com → REST API)
#    Sert à l'anti-abus : limite par IP, par appareil, verrou anti double-clic.
#    Facultatif en développement : sans ces variables, la limitation est
#    désactivée (un avertissement est affiché au démarrage).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# 3. SÉCURITÉ
#    ADMIN_SESSION_SECRET : clé de signature des cookies de session et d'admin.
#      Générez-la avec : openssl rand -base64 48
#    ADMIN_PASSWORD : mot de passe de l'espace /admin (partagé avec la vendeuse).
#    OTP_PEPPER : sel secret pour hacher les empreintes d'IP / d'appareil.
#      (Nom historique : la vérification par code a été retirée, mais changer
#      cette valeur réinitialise l'anti-abus déjà enregistré.)
# ---------------------------------------------------------------------------
ADMIN_SESSION_SECRET="changez-moi-avec-openssl-rand-base64-48-xxxxxxxxxxxx"
ADMIN_PASSWORD="mot-de-passe-admin-long-et-unique"
OTP_PEPPER="sel-secret-otp-a-changer"

# ---------------------------------------------------------------------------
# 4. WHATSAPP — plus utilisé par l'application
#    L'ancien envoi de codes de vérification a été retiré (le jeu va maintenant
#    directement de l'inscription à la roue). Aucun fournisseur n'est requis.
#    Les variables WHATSAPP_* / TWILIO_* ont été supprimées de ce fichier.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 5. URL PUBLIQUE (utilisée pour les QR codes et les liens de partage)
#    En local : http://localhost:3000
#    En production : https://votre-domaine.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BOUTIQUE_NOM="Ma Boutique"
NEXT_PUBLIC_BOUTIQUE_ADRESSE="Cotonou, Bénin"
NEXT_PUBLIC_BOUTIQUE_WHATSAPP="+22900000000"

# ---------------------------------------------------------------------------
# 6. TRACKING MARKETING (facultatif — laisser vide pour désactiver)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ---------------------------------------------------------------------------
# 7. DÉVELOPPEMENT UNIQUEMENT
#    Rien à ajouter : sans UPSTASH_*, la limitation d'abus est désactivée et
#    un avertissement apparaît dans les journaux du serveur.
# ---------------------------------------------------------------------------
